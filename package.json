{
  "name": "zombie-survival-ultima-esperanza",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "ZOMBIE SURVIVAL: ÚLTIMA ESPERANZA — shooter de supervivencia 2D en pixel art",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
